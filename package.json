{
  "name": "st-francis-xavier-church-neduvila",
  "version": "1.0.0",
  "description": "Production-ready website for St. Francis Xavier's Church, Neduvila (Kerala, India)",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/src/server.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed:admin",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "xss": "^1.0.17",
    "zod": "^3.24.1"
  }
}
