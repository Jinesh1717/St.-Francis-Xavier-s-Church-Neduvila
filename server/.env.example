# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas connection string or mongodb://localhost:27017/church_db)
# If left empty in development/test, an embedded Mongo instance is used automatically.
MONGODB_URI=

# JWT Secret (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_generate_random

# Default Admin Credentials for Seeding (npm run seed:admin)
ADMIN_USERNAME=churchadmin
ADMIN_PASSWORD=change_this_secure_password_in_production_123!

# Cloudinary Configuration (optional in local dev, uploads fall back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
